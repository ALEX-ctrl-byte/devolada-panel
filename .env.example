# URL de la API, sin barra final. Se incorpora al construir el panel (variable de BUILD).
# Desarrollo local:
VITE_API_URL=http://localhost:3000
# Producción (Railway): se define en las Variables del servicio del panel:
#   VITE_API_URL=https://api.usadevolada.com

# El mapa operativo usa Leaflet + OpenStreetMap: no requiere token ni tiene costo.
